{
  "name": "portfolio",
  "homepage": "",
  "description": "Sushanth U V Portfolio Website",
  "repository": "https://github.com/SushanthOO7/portfolio.git",
  "author": "Sushanth U V",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "node ./scripts/dev.cjs && remix vite:dev",
    "start": "wrangler pages dev ./build/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E_APP=astro playwright test",
    "test:e2e:legacy": "E2E_LEGACY=1 playwright test tests/legacy/routes.spec.js",
    "dev:astro": "astro dev --host 127.0.0.1 --port 7778",
    "build:astro": "astro build",
    "preview:astro": "astro preview --host 127.0.0.1 --port 7778",
    "postinstall": "node ./scripts/draco.cjs",
    "deploy": "npm run build && wrangler pages deploy ./build/client --project-name portfolio",
    "dev:storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "deploy:storybook": "wrangler pages deploy ./storybook-static --project-name portfolio-storybook --branch main"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@aws-sdk/client-ses": "^3.515.0",
    "@gsap/react": "^2.1.2",
    "@mdx-js/react": "^3.0.1",
    "@remix-run/cloudflare": "^2.17.0",
    "@remix-run/cloudflare-pages": "^2.17.0",
    "@remix-run/react": "^2.17.0",
    "astro": "^7.3.5",
    "framer-motion": "12.23.0",
    "gsap": "^3.14.2",
    "isbot": "^4.1.0",
    "miniflare": "^3.20231030.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-img-size": "^1.0.1",
    "rehype-slug": "^6.0.0",
    "tech-stack-icons": "^3.3.2",
    "three": "^0.180.0",
    "three-stdlib": "^2.36.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@csstools/postcss-global-data": "^2.1.1",
    "@mapbox/rehype-prism": "^0.9.0",
    "@mdx-js/rollup": "^3.0.1",
    "@playwright/test": "^1.63.0",
    "@remix-run/dev": "^2.17.0",
    "@storybook/addon-a11y": "^9.1.5",
    "@storybook/addon-docs": "^9.1.5",
    "@storybook/addon-links": "^9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^9.1.5",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.33",
    "postcss-custom-media": "^10.0.2",
    "prop-types": "^15.8.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^4.0.0",
    "storybook": "^9.1.5",
    "vite-jsconfig-paths": "^2.0.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.38.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vite": "^8.3.2"
  }
}
