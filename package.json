{
  "name": "portfolio",
  "homepage": "",
  "description": "Sushanth U V Portfolio Website",
  "repository": "https://github.com/SushanthOO7/portfolio.git",
  "author": "Sushanth U V",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:production": "node scripts/require-site-url.mjs && astro build",
    "dev": "astro dev --host 127.0.0.1 --port 7778",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build:production && wrangler deploy",
    "cf-typegen": "wrangler types",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual-parity.spec.js",
    "test:performance": "vitest run tests/performance/bundles.test.js",
    "pretest:worker": "npm run build",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "bundle:report": "node scripts/report-client-bundles.mjs dist/client/_astro",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "dev:storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1146.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^24.3.1",
    "astro": "^7.3.5",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.6.1",
    "lighthouse": "^13.5.0",
    "storybook": "^10.6.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
