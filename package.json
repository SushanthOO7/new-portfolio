{
  "name": "portfolio",
  "homepage": "",
  "description": "Sushanth U V Portfolio Website",
  "repository": "https://github.com/SushanthOO7/portfolio.git",
  "author": "Sushanth U V",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "typecheck": "astro check",
    "build:production": "node scripts/require-site-url.mjs && astro build && node scripts/verify-production-origin.mjs",
    "dev": "astro dev --host 127.0.0.1 --port 7778",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build:production && wrangler deploy",
    "cf-typegen": "wrangler types",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.1",
    "astro": "^7.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
