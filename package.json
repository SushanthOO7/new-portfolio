{
  "name": "portfolio",
  "homepage": "",
  "description": "Sushanth U V Portfolio Website",
  "repository": "https://github.com/SushanthOO7/new-portfolio.git",
  "author": "Sushanth U V",
  "type": "module",
  "scripts": {
    "github:refresh": "node --env-file-if-exists=.env scripts/refresh-github-contributions.mjs",
    "generate:splash": "node scripts/generate-name-splash.mjs",
    "build": "astro build",
    "typecheck": "astro check",
    "build:production": "node scripts/require-site-url.mjs && npm run security:scan && astro build && node scripts/finalize-production-headers.mjs && node scripts/verify-production-origin.mjs && node scripts/verify-production-security.mjs",
    "dev": "astro dev --host 127.0.0.1 --port 7778",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build:production && wrangler deploy",
    "cf-typegen": "wrangler types",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:scan": "node scripts/security/scan-secrets.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run security:scan && vitest run tests/unit/security-policy.test.js tests/unit/secret-scanner.test.js tests/unit/production-security.test.js tests/unit/site-url.test.js",
    "generate:titles": "node scripts/generate-name-splash.mjs && node scripts/generate-projects-title.mjs && node scripts/generate-title-posters.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lottie-web": "^5.13.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
