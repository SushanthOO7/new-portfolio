{
  "name": "portfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "previews": {},
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
