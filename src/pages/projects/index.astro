---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteHeader from '../../components/astro/RouteHeader.astro';
import { projects } from '../../data/projects.js';
---
<BaseLayout title="Projects" description="Selected software engineering and creative development work by Sushanth U V.">
  <RouteHeader eyebrow="Portfolio" title="Selected Work" description="A collection of projects shaped by curiosity, technical depth, and attention to the people using them." />
  <div class="project-list">
    {projects.map((project,index)=><article>
      <div class="number">{String(index+1).padStart(2,'0')}</div>
      <img src={project.image} width="1600" height="900" loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'auto'} decoding="async" alt="" />
      <div class="copy"><h2>{project.title}</h2><p>{project.description}</p><a href={`/projects/${project.slug}`} aria-label={`View ${project.title}`}>View project <span aria-hidden="true">↗</span></a></div>
    </article>)}
  </div>
</BaseLayout>
<style>
  .project-list{width:min(100%,var(--max-width));margin-inline:auto;padding:0 var(--space-outer) clamp(5rem,12vw,10rem)}article{position:relative;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(18rem,.9fr);gap:clamp(2rem,7vw,7rem);align-items:center;padding-block:clamp(3rem,8vw,7rem);border-top:1px solid color-mix(in srgb,var(--text) 15%,transparent)}article:nth-child(even) img{order:2}.number{position:absolute;top:1rem;right:0;color:color-mix(in srgb,var(--text) 24%,transparent);font-size:clamp(4rem,12vw,10rem);line-height:1;pointer-events:none}img{width:100%;aspect-ratio:16/10;object-fit:cover}.copy{position:relative}.copy h2{margin-bottom:1rem;color:var(--text);font-size:clamp(2.25rem,6vw,5rem);font-weight:400;letter-spacing:-.05em}.copy p{max-width:34rem;margin-bottom:2rem;font-size:1.1rem;line-height:1.7}.copy a{color:var(--text);text-underline-offset:.35rem}@media(max-width:46rem){article{grid-template-columns:1fr}article:nth-child(even) img{order:initial}.number{font-size:5rem}}
</style>
