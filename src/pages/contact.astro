---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/react/ContactForm.jsx';
import DisplacementSphere from '../components/react/DisplacementSphere.jsx';
---
<BaseLayout title="Contact" description="Send Sushanth U V a message about a project, an opportunity, or just to say hello.">
  <section class="contact" aria-labelledby="contact-title">
    <div class="content"><p class="eyebrow">Contact</p><h1 id="contact-title">Say hello</h1><p class="intro">Interested in working together, comparing notes, or discussing a difficult engineering problem? Send me a message.</p><ContactForm client:load /></div>
    <div class="visual"><DisplacementSphere client:visible /></div>
  </section>
</BaseLayout>
<style>
  .contact{display:grid;grid-template-columns:minmax(0,1fr) minmax(20rem,.8fr);width:min(100%,var(--max-width));min-height:calc(100svh - 7rem);margin-inline:auto;padding:clamp(3rem,8vw,7rem) var(--space-outer);gap:clamp(3rem,7vw,7rem);align-items:center}.content{max-width:42rem}.eyebrow{margin-bottom:1rem;color:var(--accent);font-size:.78rem;letter-spacing:.18em;text-transform:uppercase}h1{color:var(--text);font-size:clamp(3.5rem,9vw,8rem);font-weight:400;letter-spacing:-.065em;line-height:.9}.intro{margin-block:1.5rem 3rem;font-size:clamp(1rem,2vw,1.2rem);line-height:1.7}.visual{min-height:34rem;overflow:hidden}.visual :global(.sphere-placeholder){min-height:34rem}@media(max-width:50rem){.contact{grid-template-columns:1fr}.visual{display:none}}
</style>
