---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Embed from '../../components/astro/Embed.astro';
import { getArticleReadingTime } from '../../lib/content.js';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<ArticleLayout {...article.data} timecode={getArticleReadingTime(article.body ?? '')}>
  <Content components={{ Embed }} />
</ArticleLayout>
