---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteHeader from '../components/astro/RouteHeader.astro';
const sections=[
  {title:'Development',items:['VS Code with a focused, keyboard-first setup','Astro and React for fast, progressively enhanced interfaces','Node.js and Python for services, automation, and tooling','PostgreSQL for dependable relational data']},
  {title:'Quality & Automation',items:['Playwright for end-to-end browser confidence','Vitest for fast unit and integration feedback','Selenium for mature cross-browser automation suites','Jenkins, Docker, and cloud runners for repeatable delivery']},
  {title:'Hardware',items:['Linux workstation for daily engineering','MacBook Pro for portable development and testing','A high-refresh external display','A mechanical keyboard and ergonomic pointing setup']},
];
---
<BaseLayout title="Uses" description="The software, testing tools, and hardware Sushanth U V uses.">
  <RouteHeader eyebrow="Toolkit" title="Uses" description="A practical list of the tools I reach for to design, build, test, and ship reliable software." />
  <div class="uses-list">{sections.map(section=><section aria-labelledby={`uses-${section.title.toLowerCase().replaceAll(' ','-').replace('&','and')}`}><h2 id={`uses-${section.title.toLowerCase().replaceAll(' ','-').replace('&','and')}`}>{section.title}</h2><ul>{section.items.map(item=><li>{item}</li>)}</ul></section>)}</div>
</BaseLayout>
<style>
  .uses-list{width:min(100%,var(--max-width));margin-inline:auto;padding:0 var(--space-outer) clamp(5rem,12vw,10rem)}section{display:grid;grid-template-columns:minmax(10rem,.4fr) 1fr;gap:clamp(2rem,7vw,7rem);padding-block:clamp(2.5rem,6vw,5rem);border-top:1px solid color-mix(in srgb,var(--text) 16%,transparent)}h2{color:var(--text);font-size:clamp(1.75rem,4vw,3.5rem);font-weight:400;letter-spacing:-.04em}ul{margin:0;padding:0;list-style:none}li{padding:1.2rem 0;border-bottom:1px solid color-mix(in srgb,var(--text) 10%,transparent);font-size:clamp(1rem,2vw,1.2rem);line-height:1.55}@media(max-width:42rem){section{grid-template-columns:1fr}}
</style>
