---

<nav
  class:list={['social-links', variant === 'rail' ? 'social-rail' : 'footer-social']}
  aria-label={variant === 'rail' ? 'Social links' : 'Footer social links'}
  data-social-rail={variant === 'rail' ? true : undefined}
>
  {
    links.map(link => (
      <a
        href={link.href}
        aria-label={link.label}
        title={link.label}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d={variant === 'footer' ? footerPaths[link.label] : link.path} />
        </svg>
      </a>
    ))
  }
</nav>
<style>
  .social-links {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.4vw, 1.25rem);
    color: var(--text);
  }
  .social-links a {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .social-links a:hover {
    color: var(--accent);
  }
  .social-links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .social-links svg {
    display: block;
    width: 24px;
    height: 24px;
    fill: currentColor;
  }
  .social-rail {
    position: absolute;
    left: clamp(1.5rem, 3.2vw, 5rem);
    bottom: clamp(1.5rem, 4vw, 4rem);
    z-index: 55;
    flex-direction: column;
    gap: 0.8rem;
    color: var(--text-body);
  }
  .social-rail svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .footer-social svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 48rem) {
    .footer-social {
      gap: 0;
    }
  }
  @media (max-width: 48rem) {
    .social-rail {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-links a {
      transition: none;
    }
  }
</style>
