---
const { status = 404, summary = 'Error: redacted', message = 'This page could not be found. It may have moved, been deleted, or never existed.' } = Astro.props;
---
<section class="error-page">
  <div class="details">
    <p class="summary">{summary}</p>
    <h1>{status}</h1>
    <p class="message">{message}</p>
    <a href="/">Back to homepage <span aria-hidden="true">→</span></a>
  </div>
  <figure>
    <img src="/images/error/notfound.jpg" width="1280" height="720" alt="" />
    <figcaption>Signal lost / requested page unavailable</figcaption>
  </figure>
</section>
<style>
  .error-page{display:grid;grid-template-columns:minmax(0,.8fr) minmax(22rem,1.2fr);width:min(100%,var(--max-width));min-height:calc(100svh - 7rem);margin-inline:auto;padding:clamp(3rem,8vw,7rem) var(--space-outer);gap:clamp(3rem,8vw,8rem);align-items:center}.summary{color:var(--accent);font-size:.8rem;letter-spacing:.18em;text-transform:uppercase}h1{margin-block:1rem;color:var(--text);font-size:clamp(7rem,20vw,16rem);font-weight:400;letter-spacing:-.08em;line-height:.8}.message{max-width:34rem;margin-bottom:2rem;font-size:clamp(1rem,2vw,1.2rem);line-height:1.7}.details a{color:var(--text);text-underline-offset:.35rem}figure{margin:0}figure img{width:100%;min-height:24rem;object-fit:cover;filter:saturate(.65) contrast(1.15)}figcaption{margin-top:.75rem;color:var(--text-body);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase}@media(max-width:48rem){.error-page{grid-template-columns:1fr}figure{order:-1}figure img{min-height:16rem}}
</style>
