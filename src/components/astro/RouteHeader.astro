---
const { eyebrow, title, description } = Astro.props;
---
<header class="route-header">
  <p>{eyebrow}</p>
  <h1>{title}</h1>
  <div class="rule"></div>
  <p class="description">{description}</p>
</header>
<style>
  .route-header{width:min(100%,var(--max-width));margin-inline:auto;padding:clamp(4rem,10vw,9rem) var(--space-outer) clamp(3rem,7vw,6rem)}.route-header>p:first-child{margin-bottom:1.25rem;color:var(--accent);font-size:.78rem;letter-spacing:.18em;text-transform:uppercase}h1{max-width:12ch;color:var(--text);font-size:clamp(3.5rem,10vw,9rem);font-weight:400;letter-spacing:-.065em;line-height:.9}.rule{height:1px;margin-block:clamp(2rem,5vw,4rem);background:color-mix(in srgb,var(--text) 18%,transparent)}.description{max-width:48rem;font-size:clamp(1.1rem,2.4vw,1.6rem);line-height:1.55}
</style>
