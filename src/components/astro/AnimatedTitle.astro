---
import '../../styles/title-animations.css';
interface Props {
  name: string;
  animationSrc: string;
  poster: string;
  class?: string;
  firstStrikeDelay?: number;
  loopInterval?: number;
}
const { name, animationSrc, poster, class: className, firstStrikeDelay, loopInterval } = Astro.props;
---
<span class:list={['animated-title', className]} data-title-animation data-title-name={name} data-animation-src={animationSrc} data-first-strike-delay={firstStrikeDelay} data-loop-interval={loopInterval} data-playback="poster" aria-hidden="true">
  <span class="animated-title__poster" data-title-poster set:html={poster} />
  <span class="animated-title__player" data-title-player></span>
</span>
<script>
  import { initializeTitleAnimations } from '../../scripts/title-animations';
  let cleanup = initializeTitleAnimations();
  const dispose = () => cleanup();
  const initialize = () => { cleanup(); cleanup = initializeTitleAnimations(); };
  document.addEventListener('astro:before-swap', dispose);
  document.addEventListener('astro:page-load', initialize);
  if (import.meta.hot) import.meta.hot.dispose(() => {
    cleanup();
    document.removeEventListener('astro:before-swap', dispose);
    document.removeEventListener('astro:page-load', initialize);
  });
</script>
<style>
  .animated-title { position: relative; display: block; width: 100%; height: 100%; color: var(--text); }
  .animated-title__poster, .animated-title__player { position: absolute; inset: 0; display: block; }
  .animated-title :global(svg) { display: block; width: 100%; height: 100%; }
  .animated-title__player { visibility: hidden; }
  .animated-title[data-ready='true'] .animated-title__player { visibility: visible; }
  .animated-title[data-ready='true'] .animated-title__poster { visibility: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .animated-title[data-ready='true'] .animated-title__player { visibility: hidden; }
    .animated-title[data-ready='true'] .animated-title__poster { visibility: visible; }
  }
</style>
