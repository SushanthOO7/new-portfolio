---
import { NavToggle } from '../react/NavToggle.jsx';
import { ThemeToggle } from '../react/ThemeToggle.jsx';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/career', label: 'Career' },
  { href: '/articles', label: 'Articles' },
  { href: '/uses', label: 'Uses' },
  { href: '/contact', label: 'Contact' },
];
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = href => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="header">
  <a class="brand" href="/" aria-label="Sushanth U V, Software Engineer">S<span>UV</span></a>
  <div class="controls">
    <ThemeToggle client:load />
    <NavToggle client:load />
  </div>
  <nav id="site-navigation" class="navigation" aria-label="Primary">
    <ul>
      {links.map(link => (
        <li>
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    padding: 1.25rem var(--space-outer);
    background: color-mix(in srgb, var(--background) 82%, transparent);
    backdrop-filter: blur(18px);
  }

  .brand {
    color: var(--text);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.08em;
    text-decoration: none;
  }

  .brand span { color: var(--accent); }

  .navigation { justify-self: center; }
  .navigation ul {
    display: flex;
    gap: clamp(0.5rem, 2vw, 2rem);
    padding: 0;
    list-style: none;
  }

  .navigation a {
    position: relative;
    display: inline-block;
    padding: 0.75rem 0.25rem;
    color: var(--text-body);
    font-weight: 500;
    text-decoration: none;
  }

  .navigation a::after {
    position: absolute;
    inset-inline: 0.25rem;
    inset-block-end: 0.25rem;
    height: 2px;
    background: var(--accent);
    content: '';
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .navigation a:hover::after,
  .navigation a[aria-current='page']::after { transform: scaleX(1); }

  .controls {
    display: flex;
    grid-column: 3;
    grid-row: 1;
    gap: 0.75rem;
  }

  @media (max-width: 696px) {
    .header { grid-template-columns: auto 1fr auto; }
    .navigation {
      grid-column: 1 / -1;
      justify-self: stretch;
    }
    .navigation ul {
      flex-direction: column;
      gap: 0;
      padding-block: 1rem;
    }
    .navigation a { display: block; padding: 0.8rem 0; }
    :global(html[data-js='true']) .navigation[data-open='false'] { display: none; }
  }
</style>
