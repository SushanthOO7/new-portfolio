---
import AnimatedTitle from '../AnimatedTitle.astro';
import projectsPoster from '../../../../public/animations/projects-poster.svg?raw';
import projects from '../../../data/projects.json';
import ProjectsFolder from '../../react/ProjectsFolder.tsx';
import GitHubActivity from '../../react/GitHubActivity.tsx';
import contributionSnapshot from '../../../data/github-contributions.json';
import { loadGitHubContributions } from '../../../lib/github-contributions.js';

const githubActivity = await loadGitHubContributions({
  username: 'SushanthOO7',
  token: import.meta.env.GITHUB_TOKEN,
  snapshot: contributionSnapshot,
});
---
<section id="projects" class="projects" aria-labelledby="projects-title" data-section-guides>
  <div class="projects__inner">
    <header class="projects__header">
      <span class="projects__index">// 03</span>

      <h2 id="projects-title" aria-label="Projects"><AnimatedTitle name="Projects" animationSrc="/animations/projects-title.json" poster={projectsPoster} /></h2>
    </header>
    <ProjectsFolder client:load projects={projects} />
    <GitHubActivity
      client:visible
      username={githubActivity.username}
      fetchedAt={githubActivity.fetchedAt}
      source={githubActivity.source}
      days={githubActivity.days}
    />
    <noscript><ul class="projects-fallback">{projects.map(project => <li><a href={project.url} target="_blank" rel="noopener noreferrer"><h3>{project.title}</h3><img src={project.image.dark} alt={project.image.alt} width="480" height="192"/><p>{project.tags.join(' · ')}</p><p>{project.description}</p></a></li>)}</ul></noscript>
  </div>
</section>
<style>
  @font-face {
    font-family: Gotham;
    src: url('/fonts/gotham-bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
  }
  .projects {
    --projects-rule: rgb(171 155 136 / 17%);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 54px var(--space-outer) 33px;
    background: var(--background);
    color: var(--text);
    scroll-margin-top: 0;
  }
  .projects__inner { position: relative; max-width: var(--max-width); margin: auto; }
  .projects__header { position: relative; isolation: isolate; height: clamp(220px, 42vw, 500px); padding: 0; }
  .projects__index {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--accent);
    font-size: 12px;
    line-height: 1;
    letter-spacing: .25em;
    font-weight: 700;
  }
  h2 { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; color: var(--text); }
  h2 :global(.animated-title) { width: 100%; height: 100%; }
  .projects__list { list-style: none; margin: 0; padding: 0; }
  .projects__item { border-top: 1px solid var(--projects-rule); }
  .projects__item:last-child { border-bottom: 1px solid var(--projects-rule); }
  .projects__link {
    position: relative;
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) 80px minmax(0, 1.5fr);
    align-items: center;
    min-height: 165px;
    padding: 4px 0 4px 20px;
    color: inherit;
    text-decoration: none;
  }
  .projects__number {
    display: flex;
    align-items: center;
    align-self: start;
    gap: 16px;
    padding-top: 10px;
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: .08em;
  }
  .projects__number i { flex: none; width: 21px; height: 2px; background: var(--accent); }
  .projects__copy { align-self: start; padding-top: 10px; padding-right: 10px; }
  .projects__copy h3 {
    margin: 0 0 6px;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .projects__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--text-body);
    font-size: 8.5px;
    line-height: 1.6;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  .projects__copy p { max-width: 30ch; margin: 16px 0 0; color: var(--text-body); font-size: 12.5px; line-height: 1.55; }
  .projects__arrow {
    display: grid;
    place-items: center;
    justify-self: start;
    margin-left: 5px;
    width: 47px;
    height: 47px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    font-size: 22px;
    transition: background .2s, color .2s;
  }
  .projects__image { height: 156px; min-width: 0; transition: transform .25s ease; }
  .projects__link:hover .projects__arrow { background: var(--accent); color: var(--background); }
  .projects__link:hover .projects__image { transform: translateY(-2px); }
  .projects__link:focus-visible { outline-offset: -2px; }
  .projects__footer { display: flex; align-items: center; margin: 16px 0 0 24px; }
  .projects__footer > div { flex: 1; height: 1px; background: linear-gradient(90deg, var(--accent), transparent); }
  .projects__all {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    min-height: 54px;
    padding: 0 27px 0 0;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background .2s;
  }
  .projects__all > span:first-child {
    display: grid;
    place-items: center;
    align-self: stretch;
    width: 71px;
    margin: -1px 0 -1px -1px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-size: 28px;
    font-weight: 400;
  }
  .projects__all:hover { background: rgb(255 77 0 / 8%); }
  :global([data-theme='light']) .projects { --projects-rule: rgb(96 80 63 / 13%); }

  @media (min-width: 1100px) {
    .projects { padding-top: 70px; padding-bottom: 54px; }
    .projects__header { height: clamp(300px, 42vw, 500px); }
    .projects__link { min-height: 200px; grid-template-columns: 95px minmax(0, 1fr) 95px minmax(0, 1.5fr); }
    .projects__image { height: 184px; }
    .projects__copy h3 { font-size: 16px; }
    .projects__copy p { font-size: 14px; }
    .projects__tags { font-size: 9px; }
  }
  @media (min-width: 1024px) {
    .projects { padding-top: 24px; padding-bottom: 64px; min-height: 100svh; }
    .projects__inner { min-height: 0; }
    .projects__header { height: clamp(240px, 36svh, 400px); padding: 0; }
  
    .projects__list { min-height: 0; display: grid; grid-auto-rows: minmax(0, 1fr); }
    .projects__item { min-height: 0; }
    .projects__link { height: 100%; min-height: 0; padding-top: 8px; padding-bottom: 8px; }
    .projects__image { position: relative; align-self: stretch; height: auto; min-height: 0; }
    .projects__image :global(.preview) { position: absolute; inset: 0; }
    .projects__copy p { margin-top: 10px; }
    .projects__footer { flex: none; }
  }
  @media (min-width: 601px) and (max-width: 800px) {
    .projects__link { grid-template-columns: 60px minmax(0, 1fr) 60px minmax(0, 1.2fr); padding-left: 10px; }
    .projects__copy h3 { font-size: 12px; }
    .projects__copy p { font-size: 11px; }
    .projects__tags { font-size: 7px; gap: 4px 8px; }
    .projects__number { gap: 10px; }
    .projects__arrow { width: 43px; height: 43px; }
  }
  @media (max-width: 600px) {
    .projects { padding-top: 40px; padding-bottom: 36px; }
    .projects__header { height: clamp(180px, 50vw, 260px); padding: 0; }
    .projects__index { left: 0; font-size: 11px; }
  
    .projects__link { grid-template-columns: 45px minmax(0, 1fr) 47px; gap: 12px 8px; padding: 20px 0; }
    .projects__number { gap: 8px; padding-top: 2px; font-size: 11px; }
    .projects__number i { width: 14px; }
    .projects__copy { padding: 0; }
    .projects__copy h3 { font-size: 12px; letter-spacing: .08em; }
    .projects__tags { font-size: 7px; gap: 3px 8px; }
    .projects__copy p { margin-top: 12px; font-size: 12px; }
    .projects__arrow { align-self: start; justify-self: end; margin-left: 0; width: 43px; height: 43px; }
    .projects__image { grid-column: 2 / -1; height: auto; aspect-ratio: 2.5; }
    .projects__footer { margin-left: 0; }
    .projects__all { gap: 13px; padding-right: 20px; font-size: 9px; }
    .projects__all > span:first-child { width: 58px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .projects__arrow, .projects__image, .projects__all { transition: none; }
    .projects__link:hover .projects__image { transform: none; }
  }
</style>

<style is:global>
.projects { overflow: clip; }
.github-activity {
  --color-background: var(--surface-secondary);
  --color-foreground: var(--text);
  --color-muted-foreground: var(--text-body);
  --color-border: color-mix(in srgb, var(--text) 14%, transparent);
  /* Reserve room for the traveling navbar mark beside narrow panels. */
  --journey-clearance: max(0px, 3rem - var(--space-outer));
  width: calc(100% - var(--journey-clearance));
  margin: 18px 0 0 var(--journey-clearance);
  padding: clamp(20px, 4vw, 44px) 0 0;
  border-top: 1px solid var(--projects-rule);
}
.github-activity__eyebrow { display: flex; justify-content: space-between; gap: 16px; margin: 0 0 14px; color: var(--text-body); font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
.github-activity__eyebrow > span { color: var(--accent); }
.github-activity__eyebrow a { text-underline-offset: 4px; }
.github-activity__eyebrow a:hover { color: var(--accent); }
.github-activity__skyline { border-radius: 10px !important; box-shadow: inset 0 1px rgb(255 255 255 / 4%); }
[data-theme='light'] .github-activity { --color-background: #ebe8e2; --color-border: rgb(42 37 32 / 16%); }
.projects-fallback { display: grid; gap: 24px; list-style: none; padding: 0; }
.projects-fallback img { width: 100%; max-width: 480px; height: auto; }
@media (min-width: 1024px) and (max-height: 760px) { .projects { height: auto; min-height: 100svh; } }
@media (max-width: 600px) { .github-activity { margin-top: 8px; } .github-activity__eyebrow { align-items: flex-start; flex-direction: column; } }
</style>
