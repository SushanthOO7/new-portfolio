---
import DisplacementSphere from '../../react/DisplacementSphere.jsx';
const projects=[{title:'Gamestack',category:'Web Application',description:'A connected game library with authentication, collection tools, and social features.',href:'/projects/gamestack'},{title:'Smart Sparrow',category:'Educational Platform',description:'Interactive learning tools designed to help educators create more engaging coursework.',href:'/projects/smart-sparrow'},{title:'Slice',category:'Medical Software',description:'A collaboration workflow for medical teams reviewing and discussing biomedical imagery.',href:'/projects/slice'}];
---
<section class="projects" aria-labelledby="projects-title"><div class="content"><header><p>Selected work</p><h2 id="projects-title">Projects built around real problems.</h2></header><ol>{projects.map((project,index)=><li><span class="index">0{index+1}</span><div><p class="category">{project.category}</p><h3>{project.title}</h3><p class="description">{project.description}</p></div><a href={project.href} aria-label={`View ${project.title}`}>View project <span aria-hidden="true">↗</span></a></li>)}</ol></div></section>
<section class="sphere-stage" aria-label="Interactive visual"><DisplacementSphere client:visible /></section>
<section class="all-projects" aria-labelledby="all-projects-title"><div><img src="/images/home/hands-ok.svg" alt="" width="132" height="132" loading="lazy" /><h2 id="all-projects-title">Check out all projects</h2><a href="/projects">View All Projects <span aria-hidden="true">→</span></a></div></section>
<style>
  .projects{padding:clamp(5rem,12vw,10rem) var(--space-outer)}.content,.all-projects>div{width:min(100%,var(--max-width));margin-inline:auto}header{display:grid;grid-template-columns:.35fr 1fr;gap:2rem;margin-bottom:clamp(3rem,8vw,7rem)}header>p,.category,.index{color:var(--text-body);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase}header h2{max-width:13ch;color:var(--text);font-size:clamp(2.5rem,6vw,5.5rem);font-weight:400;letter-spacing:-.055em;line-height:1}ol{margin:0;padding:0;list-style:none}li{display:grid;grid-template-columns:.2fr 1fr auto;gap:2rem;align-items:start;padding-block:2.5rem;border-top:1px solid color-mix(in srgb,var(--text) 15%,transparent)}li h3{margin-block:.35rem .8rem;color:var(--text);font-size:clamp(1.75rem,4vw,3rem);font-weight:400}.description{max-width:42rem;line-height:1.65}li a,.all-projects a{color:var(--text);text-underline-offset:.35rem}.sphere-stage{min-height:clamp(28rem,70vw,55rem);overflow:clip;background:color-mix(in srgb,var(--accent) 6%,var(--background))}.all-projects{padding:clamp(5rem,12vw,10rem) var(--space-outer)}.all-projects>div{position:relative;padding:clamp(2rem,7vw,6rem);border:1px solid color-mix(in srgb,var(--text) 22%,transparent)}.all-projects img{position:absolute;top:1rem;right:clamp(1rem,5vw,4rem);width:clamp(4rem,10vw,8rem)}.all-projects h2{max-width:10ch;margin-bottom:2.5rem;color:var(--text);font-size:clamp(2.5rem,7vw,6rem);font-weight:400;letter-spacing:-.055em;line-height:.98}@media(max-width:42rem){header,li{grid-template-columns:1fr}li{gap:.8rem}li a{margin-top:.75rem}}
</style>
