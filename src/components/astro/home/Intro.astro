---
import FluidCursor from '../../react/FluidCursor.jsx';
const disciplines = ['Web Development', 'AI & ML', 'Test Automation', 'DevOps'];
---
<section class="intro" aria-labelledby="intro-title">
  <FluidCursor client:idle />
  <div class="copy">
    <p class="eyebrow">Portfolio / 2026</p>
    <h1 id="intro-title">Sushanth U V</h1>
    <p class="role">Software Engineer</p>
    <p class="disciplines">{disciplines.join(' · ')}</p>
  </div>
  <a class="scroll" href="#profile"><span>Explore my work</span><svg aria-hidden="true" viewBox="0 0 44 16" width="44" height="16"><path d="m1 1 21 13L43 1" fill="none" stroke="currentColor" stroke-width="2"></path></svg></a>
</section>
<style>
  .intro{position:relative;display:grid;min-height:calc(100svh - 7rem);padding:clamp(4rem,10vw,8rem) var(--space-outer) 3rem;overflow:clip;isolation:isolate}
  .intro::before{position:absolute;inset:10% -15% auto auto;z-index:-1;width:min(55vw,44rem);aspect-ratio:1;border:1px solid color-mix(in srgb,var(--accent) 35%,transparent);border-radius:50%;content:''}
  .copy{align-self:center;width:min(100%,var(--max-width));margin-inline:auto}.eyebrow,.disciplines{color:var(--text-body);font-size:clamp(.72rem,1.2vw,.88rem);letter-spacing:.16em;text-transform:uppercase}
  h1{max-width:12ch;margin-block:1.25rem 0;color:var(--text);font-size:clamp(4rem,12vw,10rem);font-weight:400;letter-spacing:-.065em;line-height:.86}.role{margin-block:1.75rem .75rem;color:var(--accent);font-size:clamp(1.5rem,3.5vw,3.25rem)}
  .scroll{display:flex;align-self:end;align-items:center;justify-content:space-between;width:min(100%,var(--max-width));margin-inline:auto;padding-block:1.25rem;border-top:1px solid color-mix(in srgb,var(--text) 20%,transparent);color:var(--text-body);text-decoration:none}.scroll svg{transition:translate 180ms ease}.scroll:hover svg{translate:0 .35rem}
  @media(max-width:42rem){.intro{min-height:calc(100svh - 5.5rem);padding-top:2rem}.disciplines{max-width:30ch;line-height:1.8}}
</style>
