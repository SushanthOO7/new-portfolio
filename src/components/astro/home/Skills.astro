---
const stack={'Frontend':['React','Astro','TypeScript','JavaScript','HTML & CSS'],'Quality':['Playwright','Selenium','Vitest','JMeter'],'Platform':['Node.js','Python','Docker','Jenkins','Cloudflare'],'Data & AI':['PostgreSQL','MongoDB','OpenCV','AI & ML']};
---
<section class="skills" aria-labelledby="skills-title"><div class="content"><header><p>Capabilities</p><h2 id="skills-title">My Stack</h2></header><div class="groups">{Object.entries(stack).map(([category,skills])=><section class="group" aria-labelledby={`stack-${category.toLowerCase().replaceAll(' ','-')}`}><h3 id={`stack-${category.toLowerCase().replaceAll(' ','-')}`}>{category}</h3><ul>{skills.map(skill=><li>{skill}</li>)}</ul></section>)}</div></div></section>
<style>
  .skills{padding:clamp(5rem,12vw,10rem) var(--space-outer);background:color-mix(in srgb,var(--text) 4%,var(--background))}.content{width:min(100%,var(--max-width));margin-inline:auto}header{display:flex;gap:2rem;align-items:baseline;justify-content:space-between;padding-bottom:2rem;border-bottom:1px solid color-mix(in srgb,var(--text) 18%,transparent)}header p,h3{color:var(--text-body);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase}h2{color:var(--text);font-size:clamp(3rem,8vw,7rem);font-weight:400;letter-spacing:-.06em}.group{display:grid;grid-template-columns:minmax(8rem,.35fr) 1fr;gap:2rem;padding-block:2rem;border-bottom:1px solid color-mix(in srgb,var(--text) 12%,transparent)}ul{display:flex;flex-wrap:wrap;gap:.65rem;margin:0;padding:0;list-style:none}li{padding:.65rem .9rem;border:1px solid color-mix(in srgb,var(--text) 18%,transparent);color:var(--text)}@media(max-width:38rem){header,.group{display:block}header p,h3{margin-bottom:1rem}}
</style>
