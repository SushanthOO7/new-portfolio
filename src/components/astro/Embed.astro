---
const { src } = Astro.props;
---
<div class="embed">
  <iframe src={src} title="Interactive code example" loading="lazy" sandbox="allow-scripts allow-same-origin allow-forms" referrerpolicy="no-referrer"></iframe>
</div>
<style>.embed{margin-block:2rem;aspect-ratio:16/10}.embed iframe{width:100%;height:100%;border:1px solid color-mix(in srgb,var(--text) 18%,transparent)}</style>
