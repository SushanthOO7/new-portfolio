---
import BaseLayout from './BaseLayout.astro';
const { title, description, roles = [], background, accent = 'var(--accent)' } = Astro.props;
---
<BaseLayout title={`Projects — ${title}`} description={description} image={background}>
  <article class="project" style={`--project-accent:${accent}`}>
    <header style={`--hero-image:url(${background})`}>
      <div class="hero-copy">
        <p>Selected project</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
        <ul aria-label="Project roles">{roles.map(role=><li>{role}</li>)}</ul>
      </div>
    </header>
    <slot />
    <nav class="project-nav" aria-label="Project navigation"><a href="/projects">← All projects</a></nav>
  </article>
</BaseLayout>
<style>
  header{position:relative;display:grid;min-height:calc(100svh - 7rem);padding:clamp(4rem,9vw,8rem) var(--space-outer);place-items:end start;overflow:hidden;background:linear-gradient(90deg,rgb(8 8 8/.9),rgb(8 8 8/.2)),var(--hero-image) center/cover no-repeat;color:#fff}header::after{position:absolute;inset:0;border:1px solid rgb(255 255 255/.14);content:'';pointer-events:none}.hero-copy{position:relative;z-index:1;width:min(100%,var(--max-width));margin-inline:auto}.hero-copy>p:first-child{margin-bottom:1.25rem;color:var(--project-accent);font-size:.78rem;letter-spacing:.18em;text-transform:uppercase}h1{max-width:12ch;font-size:clamp(3.5rem,10vw,9rem);font-weight:400;letter-spacing:-.065em;line-height:.9}.description{max-width:48rem;margin-top:2rem;font-size:clamp(1.1rem,2.4vw,1.55rem);line-height:1.6}.hero-copy ul{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2rem;padding:0;list-style:none}.hero-copy li{padding:.55rem .8rem;border:1px solid rgb(255 255 255/.28);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}.project-nav{width:min(100%,var(--max-width));margin-inline:auto;padding:4rem var(--space-outer) 8rem}.project-nav a{color:var(--text);text-underline-offset:.3rem}
</style>
